// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tabela de Users (login)
model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  cargo     String   // "admin", "secretary", "coordinator", "teacher", "student"
  fotoUrl   String?
  criadoEm  DateTime @default(now())

  // Relação: um usuário pode ser um aluno
  aluno       Aluno?
  funcionario Funcionario?
  roteiros    Roteiro[]

  @@map("users") // Nome da tabela no banco
}

// Tabela de Alunos (Dados Acadêmicos e Pessoais)
model Aluno {
  id            String   @id @default(uuid())
  matricula     String   @unique
  
  // Ligação com a tabela User (O aluno loga usando as credenciais do User)
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  status        String
  cpf           String   @unique
  nascimento    String
  sexo          String
  nivelEnsino   String
  anoTurma      String
  serieTurma    String
  anoLetivo     String
  
  // Endereço (Podemos simplificar deixando na mesma tabela por enquanto)
  cep           String
  cidade        String
  estado        String
  rua           String
  bloco         String?
  quadra        String?
  numero        String
  
  // Documentos e URLs de arquivos (Salvando os caminhos dos arquivos no servidor)
  fotoUrl       String?
  documentos    String[] // Um array de textos guardando os caminhos dos PDFs/Imagens

  criadoEm      DateTime @default(now())

  responsaveis  Responsavel[]
  deficiencias  Deficiencia[]
  alergias      Alergia[]
  frequencias   Frequencia[]
  notas         Nota[]
  requisicoes   Requisicao[]

  @@map("alunos")
}

model Responsavel {
  id         String @id @default(uuid())
  parentesco String
  nome       String
  cpf        String
  contato    String
  email      String
  
  alunoId    String
  aluno      Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@map("responsaveis")
}

model Deficiencia {
  id         String @id @default(uuid())
  nome       String
  apoio      String
  laudo      String?
  alunoId    String
  aluno      Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@map("deficiencias")
}

model Alergia {
  id         String @id @default(uuid())
  nome       String
  laudo      String?
  alunoId    String
  aluno      Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@map("alergias")
}

model Funcionario {
  id              String   @id @default(uuid())
  
  // Ligação com a tabela User (Login)
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          String
  vaga            String   // Cargo (Professor, Coordenador, etc)
  contrato        String
  periodoContrato String
  dataFimContrato String?  // Opcional, pois contratos indeterminados não têm fim

  cpf             String   @unique
  ra              String   @unique // Registro Administrativo (Matrícula do funcionário)
  nascimento      String
  sexo            String
  celular         String
  
  // Endereço
  cep             String
  cidade          String
  estado          String
  rua             String
  bloco           String?
  quadra          String?
  numero          String

  // Financeiro
  salario         String
  pagamento       String

  // Arquivos
  fotoUrl         String?
  documentos      String[]

  criadoEm        DateTime @default(now())

  // Relações
  formacoes       Formacao[]
  experiencias    Experiencia[]
  alocacoes       Alocacao[]    // As aulas que ele dá

  @@map("funcionarios")
}

model Formacao {
  id            String @id @default(uuid())
  instituicao   String
  cnpj          String
  modalidade    String
  periodoInicio String
  periodoFinal  String
  
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@map("formacoes_funcionarios")
}

model Experiencia {
  id            String @id @default(uuid())
  empresa       String
  cnpj          String
  modalidade    String
  periodoInicio String
  periodoFinal  String
  
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@map("experiencias_funcionarios")
}

// A TABELA INDEPENDENTE DE TURMAS
model Turma {
  id          String @id @default(uuid())
  ano         String // Ex: "1º Ano"
  serie       String // Ex: "A"
  periodo     String // Ex: "Matutino"
  
  // No futuro, podemos colocar um array de Alunos aqui!
  alocacoes   Alocacao[]

  // Garante que não teremos duas turmas "1º Ano A - Matutino" duplicadas no banco
  @@unique([ano, serie, periodo]) 
  @@map("turmas")
}

// A PONTE (Quem dá o quê, e onde?)
model Alocacao {
  id            String @id @default(uuid())
  disciplina    String // Ex: "Matemática"
  cargaHoraria  String // Ex: "40h"
  
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  
  turmaId       String
  turma         Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  frequencias   Frequencia[]
  notas         Nota[]

  @@map("alocacoes_disciplinas")
}

// Módulo de Calendário - Agenda Escolar
model Evento {
  id            String   @id @default(uuid())
  titulo        String
  descricao     String
  data          String   // Formato "YYYY-MM-DD"
  tipo          String   // "academic", "administrative", "holiday", "meeting"
  horarioInicio String   // Formato "HH:mm"
  horarioFim    String   // Formato "HH:mm"
  
  criadoEm      DateTime @default(now())

  @@map("eventos")
}

// Módulo de Roteiros de Aula
model Roteiro {
  id                  String   @id @default(uuid())
  titulo              String
  disciplina          String
  turma               String
  dataAplicacao       String
  status              String   // "Rascunho", "Pendente", "Aprovado", "Rejeitado"
  conteudo            String
  metodologia         String
  feedbackCoordenador String?

  // Ligação com quem criou (o Professor)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  criadoEm            DateTime @default(now())

  @@map("roteiros")
}

// Módulo de Diário de Classe e Notas
model Frequencia {
  id          String   @id @default(uuid())
  data        String   // "2026-05-20"
  presente    Boolean
  observacao  String?
  
  alunoId     String
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  
  alocacaoId  String
  alocacao    Alocacao @relation(fields: [alocacaoId], references: [id], onDelete: Cascade)

  // Garante que não temos duas presenças gravadas para o mesmo aluno, na mesma aula, no mesmo dia
  @@unique([alunoId, alocacaoId, data])
  @@map("frequencias")
}

model Nota {
  id          String   @id @default(uuid())
  bimestre    String   // "1º Bimestre"
  n1          String?
  n2          String?
  n3          String?
  n4          String?
  
  alunoId     String
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  
  alocacaoId  String
  alocacao    Alocacao @relation(fields: [alocacaoId], references: [id], onDelete: Cascade)

  // Garante que um aluno só tem um boletim por bimestre naquela disciplina
  @@unique([alunoId, alocacaoId, bimestre])
  @@map("notas")
}

// MÓDULO DE REQUISIÇÕES (SECRETARIA)
model Requisicao {
  id                 String   @id @default(uuid())
  protocolo          String   @unique
  tipo               String
  descricao          String
  status             String   @default("Pendente") 
  respostaSecretaria String?
  arquivoAnexo       String?  // O que o aluno enviou
  
  arquivoSecretaria  String?  // <-- ADICIONE ISTO: O que a secretaria devolveu!

  alunoId            String
  aluno              Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  criadoEm           DateTime @default(now())

  @@map("requisicoes")
}